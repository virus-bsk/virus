# Required: Gemini API Key - Get yours from https://aistudio.google.com/apikey
# The app will NOT build without this key.
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Required when Firebase App Check is enforced for Cloud Firestore.
# Use a reCAPTCHA Enterprise score-based site key authorized for your app domains.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Optional: EmailJS - Get your keys from https://dashboard.emailjs.com
# Service ID, Template ID, and Public Key for sending emails via EmailJS.
# If left unset, the contact form will be disabled and show a fallback
# message directing users to email support@bskcoding.com directly.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Cashfree payments.
# Preferred: point VITE_CASHFREE_API_BASE at your Cloudflare Worker proxy
# (see server/cashfree/README.md). The worker holds the secret, so nothing
# sensitive ships in the bundle. VITE_CASHFREE_MODE must match the worker's
# CASHFREE_MODE (production | sandbox).
# Direct mode (API base empty) sends the keys from the browser — Cashfree's
# CORS currently blocks this, so proxy mode is effectively required.
# Get keys from Cashfree Dashboard > Developers > API Keys.
VITE_CASHFREE_MODE=production
VITE_CASHFREE_API_BASE=
VITE_CASHFREE_PROXY_TOKEN=
VITE_CASHFREE_APP_ID=
VITE_CASHFREE_APP_SECRET=
