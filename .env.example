# Required: Gemini API Key - Get yours from https://aistudio.google.com/apikey
# The app will NOT build without this key.
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Required when Firebase App Check is enforced for Cloud Firestore.
# Use a reCAPTCHA Enterprise score-based site key authorized for your app domains.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Optional: EmailJS - Get your keys from https://dashboard.emailjs.com
# Service ID, Template ID, and Public Key for sending emails via EmailJS.
# If left unset, the contact form will be disabled and show a fallback
# message directing users to email support@bskcoding.com directly.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Cashfree payments.
# Preferred: point VITE_CASHFREE_API_BASE at your Cloudflare Worker proxy
# (see server/cashfree/README.md). The worker holds the secret, so nothing
# sensitive ships in the bundle. VITE_CASHFREE_MODE must match the worker's
# CASHFREE_MODE (production | sandbox).
# Direct mode (API base empty) sends the keys from the browser — Cashfree's
# CORS currently blocks this, so proxy mode is effectively required.
# Get keys from Cashfree Dashboard > Developers > API Keys.
VITE_CASHFREE_MODE=production
VITE_CASHFREE_API_BASE=
VITE_CASHFREE_PROXY_TOKEN=
VITE_CASHFREE_APP_ID=
VITE_CASHFREE_APP_SECRET=

# Cline API - OpenAI-compatible chat completions (via local Vite dev proxy)
# For local development: Vite proxies /api/cline to https://api.cline.bot/api/v1
# For production: deploy Cloudflare Worker at server/cline/ and set BASE_URL to worker URL
# Get your key at https://app.cline.bot Settings > API Keys
# Rotate immediately if ever exposed. Never commit this file.
VITE_CLINEC_API_KEY=YOUR_CLINEC_API_KEY_HERE
VITE_CLINEC_MODELS=nvidia/nemotron-3.5-super-vl:free,meta/muse-spark-open,xingchen-agi/xing4.0-29b-a4b:free,reflection/beam-1.0-501b-a23b
VITE_CLINEC_BASE_URL=http://localhost:5173/api/cline

# Manual trigger for the daily jobs cron — admin console "Run Daily Fetch Cron
# Now" button. Use a FINE-GRAINED personal access token scoped to this
# repository ONLY, with Account permissions -> Actions: Read and write.
# The daily 06:00 UTC schedule (.github/workflows/fetch-jobs.yml) runs
# regardless of this setting; the token only allows on-demand dispatches
# from the admin page. Leave empty to disable the manual button (the daily
# cron keeps working either way).
# NOTE: like all VITE_ values, this token is embedded in the built JS
# bundle — keep the token least-privilege and rotate it if exposed.
VITE_GITHUB_DISPATCH_TOKEN=
# Optional: owner/repo override for the dispatch target (default bskcoding/bskcoding).
VITE_GITHUB_REPO=bskcoding/bskcoding

