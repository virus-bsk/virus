rules_version = '2';

// Firestore security rules for bskcoding.
// Publish them from the Firebase console: Firestore -> Rules -> paste this
// file's contents -> Publish. Until then every read/write below is denied and
// the app fails closed (gated pages stay locked, /profile shows an error).
//
// Data model
//   users/{email-prefix}   e.g. users/bharathbsk97 — the id is the part before
//                          "@" in the account email, lowercased
//     userName  string     client-owned, trimmed, max 60 chars
//     email     string     must equal the signed-in account's email
//     isPaid    boolean    SERVER-OWNED: clients may only create it as false;
//                          only the server (Admin SDK / Cashfree webhook) may
//                          ever set it to true
//     orderId   string     SERVER-OWNED: the Cashfree / payment order id, set by
//                          the server when the user pays ("" until then). Clients
//                          may only create it as "" and never change it.
//     paymentId string     SERVER-OWNED: Cashfree's own payment id, written in
//                          the same single paid-activation write as isPaid/orderId.
//     mobileNumber string  client-owned, optional: the payer's 10-digit mobile
//                          number, collected on /payment and sent to Cashfree as
//                          customer_phone. Must be exactly 10 digits starting
//                          with 6-9. Never required for sign-in or paid checks.
//     date      timestamp  creation time (serverTimestamp), server-owned
//   pricing/{plan}         e.g. pricing/maang_kit — the fee shown on /payment,
//                          read-only for clients
//
// Everything else in the database is denied by default.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return signedIn() ? request.auth.token.email : "";
    }

    match /users/{userId} {
      // NOTE: `read` (not just `get`) so single-document onSnapshot listeners
      // are allowed. The doc id is the caller's lowercased email prefix
      // ("bharathbsk97"), recomputed here without split() (which rules don't
      // support): the prefix must match the start of the auth email and the
      // next auth-email character must be "@".
      function prefixLen() {
        return userId.size();
      }
      function prefixMatches() {
        return authEmail().lower().size() > prefixLen()
          && authEmail().lower()[0:prefixLen()] == userId
          && authEmail().lower()[prefixLen():prefixLen() + 1] == "@";
      }
      function ownsDoc() {
        return signedIn() && userId == userId.lower() && prefixMatches();
      }
      // Reading a document that does not exist yet must succeed so the app can
      // decide between "create" and "patch" at login. No account can read (or
      // squat) another account's document id — the email-field check is the
      // second layer for documents created before this binding existed.
      allow read: if ownsDoc() && (resource == null || (resource.data.email is string
        && resource.data.email.lower() == authEmail().lower()));

      // First sign-in (or the first /profile save): the client may create ONLY
      // its own document id, with the known profile fields and
      // isPaid = false, orderId = "". mobileNumber is optional.
      allow create: if ownsDoc()
        && request.resource.data.keys().hasOnly(['userName', 'email', 'isPaid', 'orderId', 'date', 'mobileNumber'])
        && request.resource.data.email is string
        && request.resource.data.email.lower() == authEmail().lower()
        && request.resource.data.userName is string
        && request.resource.data.userName.size() > 0
        && request.resource.data.userName.size() <= 60
        && request.resource.data.isPaid == false
        && request.resource.data.orderId is string
        && request.resource.data.orderId == ""
        && request.resource.data.date == request.time
        && (!('mobileNumber' in request.resource.data)
          || (request.resource.data.mobileNumber is string
            && request.resource.data.mobileNumber.size() == 10
            && request.resource.data.mobileNumber.matches('^[6-9][0-9]{9}$')));

      // Later edits may touch profile fields freely. Sandbox-direct paid
      // activation: the owner may flip isPaid false->true together with setting
      // orderId ""->non-empty in the SAME write (verified via Get Order on the
      // return_url page). Never allow unsetting isPaid, clearing orderId, or
      // changing orderId again — that only a server may do.
      allow update: if ownsDoc()
        && resource.data.email is string
        && resource.data.email.lower() == authEmail().lower()
        && request.resource.data.email is string
        && request.resource.data.email.lower() == authEmail().lower()
        && request.resource.data.userName is string
        && request.resource.data.userName.size() > 0
        && request.resource.data.userName.size() <= 60
        && (
          // 1) plain profile edit: paid fields untouched; mobileNumber (the
          //    payer's 10-digit number, client-owned) may be added or changed
          //    but must always look like a valid Indian mobile number. Only
          //    validated when actually written, so a legacy value stored by
          //    other means can never brick later edits.
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['userName', 'email', 'mobileNumber'])
            && request.resource.data.isPaid == resource.data.isPaid
            && request.resource.data.orderId == resource.data.orderId
            && (!('mobileNumber' in request.resource.data.diff(resource.data).affectedKeys())
              || (request.resource.data.mobileNumber is string
                && request.resource.data.mobileNumber.size() == 10
                && request.resource.data.mobileNumber.matches('^[6-9][0-9]{9}$')))
          )
          ||
          // 2) paid activation: false->true + orderId (+ paymentId) set,
          //    nothing else changes. paymentId is Cashfree's own payment id.
          //    The orderId must look like one this app mints
          //    (<sanitized-email-prefix>_<timestamp>). That the order really
          //    belongs to THIS account is enforced where the id is known:
          //    Payment.jsx checks the minted prefix plus Cashfree's
          //    customer_email before writing, and the webhook maps through
          //    customer_email server-side. The rules language cannot strip
          //    characters from userId ("v.bharathbsk97" -> "vbharathbsk97"), so
          //    an exact prefix-binding check here would brick activation for
          //    dotted emails — the format guard is what rules can express.
          (
            resource.data.isPaid == false
            && (resource.data.orderId == "" || !(resource.data.orderId is string))
            && request.resource.data.isPaid == true
            && request.resource.data.orderId is string
            && request.resource.data.orderId.matches('^[A-Za-z0-9_-]+_[0-9]{10,}$')
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['isPaid', 'orderId', 'paymentId'])
          )
        );

      allow delete: if false;
    }

    match /pricing/{planId} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}