rules_version = '2';

// Firestore security rules for bskcoding.
// Publish them from the Firebase console: Firestore -> Rules -> paste this
// file's contents -> Publish. Until then every read/write below is denied and
// the app fails closed (gated pages stay locked, /profile shows an error).
//
// Data model
//   users/{email-prefix}   e.g. users/bharathbsk97 — the id is the part before
//                          "@" in the account email, lowercased
//     userName  string     client-owned, trimmed, max 60 chars
//     email     string     must equal the signed-in account's email
//     isPaid    boolean    SERVER-OWNED: clients may only create it as false;
//                          only the server (Admin SDK / Cashfree webhook) may
//                          ever set it to true
//     date      timestamp  creation time (serverTimestamp), server-owned
//   pricing/{plan}         e.g. pricing/maang_kit — the fee shown on /payment,
//                          read-only for clients
//
// Everything else in the database is denied by default.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return signedIn() ? request.auth.token.email : "";
    }

    // The document id is the lowercased email prefix ("bharathbsk97" for
    // "bharathbsk97@gmail.com"). Binding {userId} to it gives the strict 1:1
    // mapping a UID would give, without migrating the existing documents.
    function emailPrefix() {
      return authEmail().lower().split("@")[0];
    }

    function ownsDoc(userId) {
      return signedIn() && userId == emailPrefix();
    }

    match /users/{userId} {
      // Reading a document that does not exist yet must succeed so the app can
      // decide between "create" and "patch" at login. The doc id is bound to
      // the caller's email prefix, so no account can read (or squat) another
      // account's document id — the email-field check below is the second
      // layer for documents created before this binding existed.
      // NOTE: `read` (not just `get`) so single-document onSnapshot listeners
      // are allowed; collection queries still fail because no query can prove
      // every result belongs to the caller.
      allow read: if ownsDoc(userId) && (resource == null || (resource.data.email is string
        && resource.data.email.lower() == authEmail().lower()));

      // First sign-in (or the first /profile save): the client may create ONLY
      // its own document id, with exactly the four known fields and
      // isPaid = false.
      allow create: if ownsDoc(userId)
        && request.resource.data.keys().hasOnly(['userName', 'email', 'isPaid', 'date'])
        && request.resource.data.email is string
        && request.resource.data.email.lower() == authEmail().lower()
        && request.resource.data.userName is string
        && request.resource.data.userName.size() > 0
        && request.resource.data.userName.size() <= 60
        && request.resource.data.isPaid == false
        && request.resource.data.date == request.time;

      // Later edits may touch only the profile fields of the account's own
      // document id. affectedKeys() limits the DELTA, so isPaid/date — which
      // are part of the resulting document — can never be written by a client.
      allow update: if ownsDoc(userId)
        && resource.data.email is string
        && resource.data.email.lower() == authEmail().lower()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['userName', 'email'])
        && request.resource.data.email is string
        && request.resource.data.email.lower() == authEmail().lower()
        && request.resource.data.userName is string
        && request.resource.data.userName.size() > 0
        && request.resource.data.userName.size() <= 60;

      allow delete: if false;
    }

    match /pricing/{planId} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}